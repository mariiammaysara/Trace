__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# data/ contents (keep the directory tracked via .gitkeep)
data/*
!data/.gitkeep

# downloaded model weights (fetched on demand by ultralytics, not source)
*.pt
*.onnx
*.engine

# models/ contents (fine-tuned weight exports -- *.pt above already covers the
# files themselves, this keeps the directory tracked via .gitkeep)
models/*
!models/.gitkeep

# Phase 13 training pipeline: raw downloaded datasets (ultralytics' own
# datasets_dir, configured to live in the repo root -- see training/README
# notes in TRACE_STUDY_GUIDE.md Section 2), generated train/val split lists,
# and ultralytics' own run output (checkpoints, plots, logs per run) -- all
# regenerated by running training/prepare_dataset.py and training/train.py,
# not source.
datasets/
training/data/
training/runs/
