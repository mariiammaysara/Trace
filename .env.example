# Copy to .env (gitignored) to override any default below.
# `docker compose up` reads .env from the project root automatically --
# every variable here has a working default, so `docker compose up` with NO
# .env file at all is a real, valid way to run the whole stack.

# --- Database ---
# Change all three together if you override any of them -- api/worker build
# DATABASE_URL from these same values, so they can't drift out of sync.
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace
POSTGRES_DB=trace

# --- API (src/api/app.py) ---
# Comma-separated origins allowed to call the API from a browser. The
# default matches both the dashboard container's own host port below
# (5173) and `npm run dev`'s Vite dev server, so either way of running the
# dashboard works against this API without a CORS error.
TRACE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRACE_LOG_LEVEL=INFO

# --- Detector (src/detection/yolo_detector.py) -- shared by the API's agent
# tools and the pipeline worker ---
TRACE_DETECTOR_WEIGHTS=yolov8n.pt
TRACE_DETECTOR_CONFIDENCE=0.25

# --- Pipeline worker (scripts/persist_video.py / docker-compose's `worker`
# service) ---
# Resolved INSIDE the container, under the ./data bind mount -- data/ is
# gitignored (real footage stays local, never committed or baked into the
# image, see Section 2), so a fresh clone has nothing here until you add
# your own video at data/<name>.mp4 on the host, or point this at a live
# camera index (e.g. 0 -- requires passing the device through to the
# container, not set up by default in docker-compose.yml).
TRACE_CAMERA_SOURCE=data/sample.mp4
TRACE_CAMERA_ID=demo
# TRACE_NUM_FRAMES=200   # uncomment to cap frames processed; default: run until the source is exhausted

# OVERSPEED/SUDDEN_STOP are computed from the camera's homography world
# scale -- every camera shipped here has only a placeholder/illustrative one
# (see configs/cameras/*.json), so both are suppressed (unreachably high) by
# default. Lower these only for a camera with a real, surveyed homography.
TRACE_SPEED_LIMIT=1e9
TRACE_MIN_DECELERATION_MAGNITUDE=1e9

# --- Vision Agent (src/agent/) -- optional ---
# Leave both provider keys below blank to run everything else normally;
# POST /agent/query returns a clean 503 (not a crash) until the selected
# provider's key is set.
#
# TRACE_LLM_PROVIDER picks which LLM backend build_llm_client()
# (src/agent/llm.py) constructs. Only the key for whichever provider you
# pick needs to be set -- the other one is ignored.
#   anthropic  (default) -- needs ANTHROPIC_API_KEY
#   openrouter            -- needs OPENROUTER_API_KEY, get one free at
#                             https://openrouter.ai/keys
TRACE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Overrides the active provider's default model
# (claude-sonnet-4-5 for anthropic, openrouter/free for openrouter).
# TRACE_LLM_MODEL=

# --- Dashboard (dashboard/Dockerfile) ---
# Vite bakes this in at BUILD time, not read at container runtime -- run
# `docker compose build dashboard` again after changing it, a restart alone
# won't pick up the change.
VITE_API_BASE_URL=http://localhost:8000
